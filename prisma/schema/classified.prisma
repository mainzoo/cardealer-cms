model Classified {
    id             Int              @id @default(autoincrement())
    views          Int              @default(0)
    slug           String           @unique
    vin            String?          @unique
    title          String?
    description    String?
    year           Int
    odoReading     Int              @default(0) @map("odo_reading")
    doors          Int              @default(4)
    seats          Int              @default(5)
    price          Int              @default(0) @map("price")
    makeId         Int              @map("make_id")
    make           Make             @relation(fields: [makeId], references: [id])
    modelId        Int              @map("model_id")
    model          Model            @relation(fields: [modelId], references: [id])
    modelVariantId Int?             @map("model_variant_id") // En UI: "Trim Level"
    modelVariant   ModelVariant?    @relation(fields: [modelVariantId], references: [id])
    drivetrain     Drivetrain       @default(FWD)
    transmission   Transmission     @default(AUTOMATIC)
    color          Color            @default(BLACK)
    fuelType       FuelType         @default(GASOLINE)
    bodyType       BodyType         @default(SEDAN)
    odoUnit        OdoUnit          @default(MILES)
    currency       CurrencyCode     @default(USD)
    features       String[]
    status         ClassifiedStatus @default(DRAFT)
    images         Image[]
    customers      Customer[]
    createdAt      DateTime         @default(now()) @map("created_at")
    updatedAt      DateTime         @updatedAt @map("updated_at")

    @@index([makeId, modelId], name: "index_make_model")
    @@index([status], name: "index_status")
    @@index([price], name: "index_price")
    @@map("classifieds")
}

// --- ENUMS ADAPTADOS AL MERCADO DE EE. UU. ---

enum ClassifiedStatus {
    LIVE
    DRAFT
    SOLD
}

enum CurrencyCode {
    USD
}

enum OdoUnit {
    MILES
    KILOMETERS
}

enum BodyType {
    SEDAN
    SUV
    TRUCK
    COUPE
    CONVERTIBLE
    HATCHBACK
    WAGON
    VAN
    MINIVAN
}

enum FuelType {
    GASOLINE
    DIESEL
    ELECTRIC
    HYBRID
    PLUG_IN_HYBRID
}

enum Color {
    BLACK
    WHITE
    SILVER
    GRAY
    RED
    BLUE
    BROWN
    GREEN
    BEIGE
    GOLD
    YELLOW
    ORANGE
    PURPLE
}

enum Transmission {
    AUTOMATIC
    MANUAL
}

enum Drivetrain {
    FWD         // Tracción delantera
    RWD         // Tracción trasera
    AWD         // Tracción integral permanente
    FOUR_WD     // 4x4 (Prisma no permite empezar enums con números, usa FOUR_WD)
}
